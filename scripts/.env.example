# Sao chép file này thành .env (cùng thư mục scripts/) và điền giá trị.
# Không commit scripts/.env (đã có trong .gitignore).
#
# Windows (Git Bash): mặc định script push + Portainer — cần jq + curl; nếu thiếu jq: scoop/choco install jq.
# Chỉ build local (không push / Portainer): ./docker-build-push-multi-portainer-local.sh --no-push
# Push nhưng không deploy Portainer: ./docker-build-push-multi-portainer-local.sh --no-portainer

# Registry / tag (tùy chọn — có giá trị mặc định trong script)
DOCKER_IMAGE_REPO=dungnt118/freepbx

# Manifest Portainer (đường dẫn từ root repo)
PORTAINER_DEPLOY_MANIFEST=deploy/portainer-deploy-manifest.json

# Docker Hub — mặc định có push (docker login + push); bỏ bằng --no-push
# Nếu token có ký tự đặc biệt, bọc trong dấu nháy đơn: DOCKERHUB_TOKEN='...'
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Portainer — mặc định deploy sau push; bỏ bằng --no-portainer (nếu có manifest + targets)
PORTAINER_URL=
PORTAINER_API_TOKEN=
PORTAINER_ENDPOINT_ID=

# Phiên bản image (tùy chọn). Nếu để trống: dùng tham số dòng lệnh, hoặc package.json + git SHA
# VERSION=3.0.0-local
